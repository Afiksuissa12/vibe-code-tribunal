# The Tribunal — local configuration example.
#
# Copy to a real environment (export in your shell, or a gitignored .env.local)
# and fill in the values there. NEVER put a real value in this file: it is
# committed.
#
# Variable NAMES only below. No values.

# --- proxy process only (src/server/anthropicProxy.mjs) ----------------------
# Read by the server process. NEVER exposed to the browser, and never prefixed
# with VITE_ (Vite inlines every VITE_-prefixed variable into the bundle).

# Required. Your Anthropic API key.
ANTHROPIC_API_KEY=

# Optional. Overrides the default model (a current small/fast Anthropic model).
ANTHROPIC_MODEL=

# Optional. Output token cap per call. Defaults to 1024.
ANTHROPIC_MAX_TOKENS=

# Optional. Provider origin. Defaults to the Anthropic API. Point it at a local
# stub provider for a token-free end-to-end run.
ANTHROPIC_BASE_URL=

# Optional. Port the proxy listens on, bound to 127.0.0.1. Defaults to 8787.
TRIBUNAL_PROXY_PORT=

# Optional. Extra comma-separated browser origins allowed to call the proxy.
# The Vite dev (:5173) and preview (:4173) origins are always allowed.
TRIBUNAL_ALLOWED_ORIGINS=

# --- browser build -----------------------------------------------------------
# Read by Vite and inlined into the bundle. Never put a secret here.

# Selects which LlmClient the app wires up — the deterministic fake, or the
# real one that calls the proxy. The accepted values are defined by the browser
# adapter (src/llm/), not by the proxy.
VITE_TRIBUNAL_LLM=

# Optional. Origin of the running proxy. Defaults to http://localhost:8787.
VITE_TRIBUNAL_PROXY_URL=
